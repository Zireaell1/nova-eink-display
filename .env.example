FETCH_INTERVAL=120

# Partial refreshes between full ones. Higher = less flashing, more ghosting.
MAX_PARTIAL_REFRESHES=8

# One blink per tick at most; each costs two partial refreshes.
BLINK_PROBABILITY=0.4
BLINK_SECONDS=1

# Panel deep-sleeps outside these hours. Set equal to disable.
NIGHT_START_HOUR=23
NIGHT_END_HOUR=6

PROMETHEUS_URL=

PROMETHEUS_API_USERNAME=
PROMETHEUS_API_PASSWORD=

INSTANCE=

SIMULATE=true

INVERT_COLORS=false

TIMEZONE=Europe/Warsaw

LOG_LEVEL=INFO
