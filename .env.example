FETCH_INTERVAL=60

# Partial refreshes between full ones. Higher = less flashing, more ghosting.
MAX_PARTIAL_REFRESHES=16

# One blink per tick at most; each costs two partial refreshes.
BLINK_PROBABILITY=0.4
BLINK_SECONDS=1

# Panel deep-sleeps outside these hours. Set equal to disable.
NIGHT_START_HOUR=23
NIGHT_END_HOUR=6

# Prometheus exposition for the display itself. Loopback only; 0 disables it.
# This listener also answers /preview.png, for local debugging.
METRICS_ADDRESS=127.0.0.1
METRICS_PORT=9110

# A second listener serving ONLY /preview.png, for a reverse proxy to pick up.
# Both an address and a port are required; leaving either blank keeps it off. Prefer
# the host's own LAN address over 0.0.0.0 so it binds one interface.
PREVIEW_ADDRESS=
PREVIEW_PORT=0

# Where the lifetime refresh counters live. Unset means they reset on every start.
STATE_DIRECTORY=

PROMETHEUS_URL=

PROMETHEUS_API_USERNAME=
PROMETHEUS_API_PASSWORD=

INSTANCE=

SIMULATE=true

INVERT_COLORS=false

TIMEZONE=Europe/Warsaw

LOG_LEVEL=INFO
